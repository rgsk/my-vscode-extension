{
  "name": "my-vscode-extension",
  "displayName": "rgsk utils",
  "description": "Personal editor commands that VSCode doesn't ship.",
  "version": "0.0.1",
  "publisher": "rgsk",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:rgsk.copyFileName",
    "onCommand:rgsk.openChangeHere",
    "onCommand:rgsk.toggleProblems",
    "onCommand:rgsk.revertWithConfirm",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rgsk.copyFileName",
        "title": "Copy File Name",
        "category": "rgsk"
      },
      {
        "command": "rgsk.openChangeHere",
        "title": "Open Changes Here",
        "category": "rgsk"
      },
      {
        "command": "rgsk.toggleProblems",
        "title": "Toggle Problems (Squiggles)",
        "category": "rgsk"
      },
      {
        "command": "rgsk.revertWithConfirm",
        "title": "Revert File (Confirm)",
        "category": "rgsk"
      },
      {
        "command": "rgsk.unpatchClaudeLatex",
        "title": "Remove LaTeX Patch from Claude Code",
        "category": "rgsk"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rgsk.copyFileName",
          "group": "6_copypath@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "rgsk.copyFileName",
          "group": "1_copypath@100"
        }
      ]
    },
    "notebookRenderer": [
      {
        "id": "rgsk.cell-numbers",
        "displayName": "Cell numbers on rendered markdown",
        "entrypoint": {
          "extends": "vscode.markdown-it-renderer",
          "path": "./cell-numbers-renderer.js"
        },
        "requiresMessaging": "optional"
      }
    ],
    "configuration": {
      "title": "rgsk utils",
      "properties": {
        "rgsk.checkOnSave.command": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Checker run on each saved `.py`, `.pyn` or `.ipynb`, the file's path appended, in the workspace folder; its `path:line:col - message` lines (a notebook's `path:cell N:line:col - message`) show as warning squiggles. Empty: off. E.g. `uv run annotation-check`."
        }
      }
    }
  }
}
